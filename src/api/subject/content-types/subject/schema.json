{
  "kind": "collectionType",
  "collectionName": "subjects",
  "info": {
    "singularName": "subject",
    "pluralName": "subjects",
    "displayName": "Θέματα DDC",
    "description": "Θεματική ταξινόμηση Dewey Decimal Classification (από Biblionet)"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "subjectTitle": {
      "type": "string",
      "required": true
    },
    "subjectDDC": {
      "type": "string"
    },
    "biblionetSubjectId": {
      "type": "string",
      "unique": true
    },
    "books": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::book.book",
      "mappedBy": "subjects"
    }
  }
}
