{
  "kind": "collectionType",
  "collectionName": "publishers",
  "info": {
    "singularName": "publisher",
    "pluralName": "publishers",
    "displayName": "Εκδότες",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "biblionetCompanyId": {
      "type": "string",
      "unique": true,
      "column": {
        "unique": true
      }
    },
    "address": {
      "type": "text"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "books": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::book.book",
      "mappedBy": "publisher"
    },
    "alternativeName": {
      "type": "string"
    },
    "qualifier": {
      "type": "string"
    },
    "catalogedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::library.library"
    },
    "reviewed": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "mergeInto": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::publisher.publisher"
    },
    "searchKey": {
      "type": "text",
      "private": true
    },
    "matchKey": {
      "type": "text",
      "private": true
    }
  }
