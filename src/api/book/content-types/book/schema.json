{
  "kind": "collectionType",
  "collectionName": "books",
  "info": {
    "singularName": "book",
    "pluralName": "books",
    "displayName": "Έντυπα",
    "description": "Ενοποιημένος πίνακας για Βιβλία, Μπροσούρες και Τεύχη Περιοδικών"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "Βιβλίο",
        "Μπροσούρα",
        "Περιοδικό"
      ],
      "required": true
    },
    "isbn": {
      "type": "string",
      "unique": true,
      "column": {
        "unique": true
      }
    },
    "subtitle": {
      "type": "string"
    },
    "yearPublished": {
      "type": "integer"
    },
    "description": {
      "type": "text"
    },
    "summary": {
      "type": "text"
    },
    "pages": {
      "type": "integer"
    },
    "language": {
      "type": "string"
    },
    "originalLanguage": {
      "type": "string"
    },
    "coverImageUrl": {
      "type": "string"
    },
    "binding": {
      "type": "string"
    },
    "edition": {
      "type": "string"
    },
    "dimensions": {
      "type": "string"
    },
    "place": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "series": {
      "type": "string"
    },
    "price": {
      "type": "decimal"
    },
    "weight": {
      "type": "integer"
    },
    "biblionetId": {
      "type": "string",
      "unique": true,
      "column": {
        "unique": true
      }
    },
    "biblionetCategoryId": {
      "type": "string"
    },
    "issueNumber": {
      "type": "string"
    },
    "publicationMonthYear": {
      "type": "string"
    },
    "issueOrder": {
      "type": "integer",
      "private": true
    },
    "publisher": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::publisher.publisher",
      "inversedBy": "books"
    },
    "copies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::copy.copy",
      "mappedBy": "publication"
    },
    "magazine": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::magazine.magazine",
      "inversedBy": "issues"
    },
    "subjects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::subject.subject",
      "inversedBy": "books"
    },
    "contributors": {
      "type": "component",
      "repeatable": true,
      "component": "catalog.contributor"
    },
    "catalogedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::library.library"
    },
    "reviewed": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "mergeInto": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::book.book"
    },
    "searchKey": {
      "type": "text",
      "private": true
    },
    "matchKey": {
      "type": "text",
      "private": true
    }
  }
}
