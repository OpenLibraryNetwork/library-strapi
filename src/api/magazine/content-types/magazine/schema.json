{
  "kind": "collectionType",
  "collectionName": "magazines",
  "info": {
    "singularName": "magazine",
    "pluralName": "magazines",
    "displayName": "Περιοδικά",
    "description": "Τίτλοι περιοδικών (π.χ. National Geographic). Τα τεύχη αποθηκεύονται ως Έντυπα (type=Περιοδικό)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "issn": {
      "type": "string",
      "unique": true
    },
    "publisher": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::publisher.publisher"
    },
    "issues": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::book.book",
      "mappedBy": "magazine"
    }
  }
}
